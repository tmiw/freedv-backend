+/* Returns the cache slot holding the weights for (start_filter_index,
+** increment), filling one if needed, or -1 to have the caller fall back to
+** calc_output_single(). */
+static inline int
+sinc_phase_lookup (SINC_FILTER *filter, increment_t max_filter_index, increment_t increment, increment_t start_filter_index)
+{	SINC_PHASE	*phases = filter->phases ;
+	int			k, slot ;
+
+	if (phases == NULL)
+		return -1 ;
+
+	filter->phase_clock ++ ;
+
+	/* Track the miss rate over each window of lookups; see
+	** SINC_PHASE_CACHE_BYPASS. */
+	if (filter->phase_bypass > 0)
+	{	/* Bypass only kicks in when most lookups miss, so don't bother
+		** searching either. */
+		filter->phase_bypass -- ;
+		return -1 ;
+		}
+	else if (++ filter->phase_lookups >= SINC_PHASE_CACHE_WINDOW)
+	{	if (filter->phase_misses * 4 > filter->phase_lookups)
+			filter->phase_bypass = SINC_PHASE_CACHE_BYPASS ;
+		filter->phase_lookups = filter->phase_misses = 0 ;
+		} ;
+
+	/* Fast path: consecutive output samples usually alternate among a few
+	** phases, but a single-phase stream (integer downsampling) always hits
+	** the MRU slot. */
+	slot = filter->phase_mru ;
+	if (phases [slot].start_filter_index == start_filter_index && phases [slot].increment == increment)
+	{	phases [slot].last_used = filter->phase_clock ;
+		return slot ;
+		} ;
+
+	for (k = 0 ; k < SINC_PHASE_CACHE_SLOTS ; k++)
+		if (phases [k].start_filter_index == start_filter_index && phases [k].increment == increment)
+		{	phases [k].last_used = filter->phase_clock ;
+			filter->phase_mru = k ;
+			return k ;
+			} ;
+
+	filter->phase_misses ++ ;
+
+	/* Evict the least recently used slot (empty slots have last_used 0). */
+	slot = 0 ;
+	for (k = 1 ; k < SINC_PHASE_CACHE_SLOTS ; k++)
+		if (phases [k].last_used < phases [slot].last_used)
+			slot = k ;
+
+	phases [slot].increment = 0 ;
