+/* Fills phase slot `slot` with the tap weights calc_output_single() would
+** interpolate for (start_filter_index, increment), using the identical
+** expression (coeffs [indx] + fraction * coeff_deltas [indx], in double) so
+** the cached path is bit-exact with the inline one. Returns 0 if the taps
+** don't fit in the slot. */
+static int
+sinc_phase_fill (SINC_FILTER *filter, int slot, increment_t max_filter_index, increment_t increment, increment_t start_filter_index)
+{	SINC_PHASE	*phase = &filter->phases [slot] ;
+	double		*left_w = filter->phase_weights + (size_t) 2 * slot * filter->phase_cap ;
+	double		*right_w = left_w + filter->phase_cap ;
+	increment_t	filter_index ;
+	int			coeff_count, n ;
+
+	/* Left half: taps in ascending data_index order, the order
+	** calc_output_single() visits them in. */
+	filter_index = start_filter_index ;
+	coeff_count = (max_filter_index - filter_index) / increment ;
+	filter_index = filter_index + coeff_count * increment ;
+	if (filter_index / increment + 1 > filter->phase_cap)
+		return 0 ;
+	phase->left_offset = coeff_count ;
+	n = 0 ;
+	while (filter_index >= MAKE_INCREMENT_T (0))
+	{	int indx = fp_to_int (filter_index) ;
+		assert (indx >= 0 && indx + 1 < filter->coeff_half_len + 2) ;
+		left_w [n++] = filter->coeffs [indx] + fp_to_double (filter_index) * filter->coeff_deltas [indx] ;
+		filter_index -= increment ;
+		} ;
+	phase->left_count = n ;
+
+	/* Right half: taps in descending data_index order; the first one is
+	** unconditional, matching the original do-while. */
+	filter_index = increment - start_filter_index ;
+	coeff_count = (max_filter_index - filter_index) / increment ;
+	filter_index = filter_index + coeff_count * increment ;
+	if (filter_index / increment + 1 > filter->phase_cap)
+		return 0 ;
+	phase->right_offset = coeff_count ;
+	n = 0 ;
+	do
+	{	int indx = fp_to_int (filter_index) ;
+		assert (indx < filter->coeff_half_len + 2) ;
+		right_w [n++] = filter->coeffs [indx] + fp_to_double (filter_index) * filter->coeff_deltas [indx] ;
+		filter_index -= increment ;
 		}
 	while (filter_index > MAKE_INCREMENT_T (0)) ;
+	phase->right_count = n ;
+
+	phase->start_filter_index = start_filter_index ;
+	phase->increment = increment ;
+	return 1 ;
